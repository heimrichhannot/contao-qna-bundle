{% extends '@Contao/content_element/_base.html.twig' %}

{% block wrapper_tag %}section{% endblock %}

{% block content %}
    {% if as_editor_view %}
        <p class="qna-editor-hint">{{ 'qna.reader.editor_hint'|trans({}, 'contao_default') }}</p>
    {% else %}
        <div class="qna-reader">
            <h2 class="qna-reader__title">{{ view.title }}</h2>
            <turbo-frame
                id="{{ view.frameId }}"
                class="qna-reader__frame"
                src="{{ frame_src }}"
                loading="lazy"
                data-qna-frame="reader"
                data-qna-poll
                data-qna-poll-interval="{{ polling_interval }}"
                data-qna-poll-max-interval="{{ polling_max_interval }}"
            >
                <p class="qna-reader__loading">{{ 'qna.reader.loading'|trans({}, 'contao_default') }}</p>
            </turbo-frame>
        </div>
    {% endif %}
{% endblock %}

{% block style %}
    {% add 'qna_styles' to stylesheets %}
        <link rel="stylesheet" href="{{ asset('qna.css', 'heimrich_hannot_qna') }}">
    {% endadd %}
{% endblock %}

{% block script %}
    {% if not as_editor_view %}
        {% add 'qna_frontend' to body %}
            <script type="module" src="{{ asset('qna.js', 'heimrich_hannot_qna') }}"></script>
        {% endadd %}
    {% endif %}
{% endblock %}
