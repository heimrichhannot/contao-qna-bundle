{% extends '@Contao/content_element/_base.html.twig' %}

{% block wrapper_tag %}section{% endblock %}

{% block content %}
    <div{{ attrs().addClass('qna-session-list').mergeWith(list_attributes|default) }}>
        {% if sessions is empty %}
            <p class="qna-empty">{{ 'qna.session_list.empty'|trans({}, 'contao_default') }}</p>
        {% else %}
            <ul class="qna-session-list__items">
                {% for session in sessions %}
                    <li class="qna-session-list__item">
                        <a{{ attrs()
                            .addClass('qna-session-list__link')
                            .set('href', session.url)
                            .set('aria-label', 'qna.session_list.open'|trans([session.title], 'contao_default'))
                            .mergeWith(link_attributes|default)
                        }}>{{ session.title }}</a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
{% endblock %}
