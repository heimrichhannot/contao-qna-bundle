<div
    id="{{ view.controlsContentId }}"
    class="qna-reader__controls qna-reader__controls--{{ view.state }}"
    data-qna-state="{{ view.state }}"
>
    {% if error_translation_key %}
        <p class="qna-message qna-message--error" role="alert">
            {{ error_translation_key|trans({}, 'contao_default') }}
        </p>
    {% endif %}

    <p class="qna-reader__status qna-reader__status--{{ view.state }}" role="status" aria-live="polite">
        {{ view.statusTranslationKey|trans({}, 'contao_default') }}
    </p>

    {% if view.showQuestionForm %}
        <form
            class="qna-question-form"
            action="{{ question_form_action }}"
            method="post"
            data-turbo-frame="{{ view.questionsFrameId }}"
        >
            <label class="qna-question-form__label" for="qna-session-{{ view.sessionId }}-question">
                {{ 'qna.question.label'|trans({}, 'contao_default') }}
            </label>
            <textarea
                class="qna-question-form__input"
                id="qna-session-{{ view.sessionId }}-question"
                name="question"
                maxlength="{{ max_question_length }}"
                required
            >{{ question_value }}</textarea>
            <input type="hidden" name="REQUEST_TOKEN" value="{{ request_token }}">
            <button class="qna-button qna-question-form__submit" type="submit">
                {{ 'qna.question.submit'|trans({}, 'contao_default') }}
            </button>
        </form>
    {% endif %}
</div>
