{% set questions_attributes = attrs()
    .addClass('qna-reader__questions')
    .set('data-qna-poll-interval', polling_interval)
    .set('data-qna-state', view.state)
    .mergeWith(questions_attributes|default)
%}

<div{{ questions_attributes }}>
    {% if error_translation_key %}
        <p class="qna-message qna-message--error" role="alert">
            {{ error_translation_key|trans({}, 'contao_default') }}
        </p>
    {% endif %}

    {% if view.showQuestions %}
        {% include '@Contao/qna/question_list.html.twig' with {
            questions: questions,
            frame_id: view.questionsFrameId ~ '-list',
            show_vote_buttons: view.showVoteButtons,
            vote_urls: vote_urls,
            request_token: request_token
        } only %}
    {% endif %}
</div>
