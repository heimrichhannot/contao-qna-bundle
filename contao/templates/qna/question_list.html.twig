{% set list_attributes = attrs()
    .set('id', frame_id)
    .addClass('qna-questions')
    .mergeWith(list_attributes|default)
%}

<div{{ list_attributes }}>
    {% if questions is empty %}
        <p class="qna-empty">{{ (empty_translation_key|default('qna.questions.empty'))|trans({}, 'contao_default') }}</p>
    {% else %}
        <ol{{ attrs().addClass('qna-question-list').mergeWith(items_attributes|default) }}>
            {% for question in questions %}
                {% include '@Contao/qna/question.html.twig' with {
                    question: question,
                    show_vote_button: show_vote_buttons,
                    vote_url: vote_urls[question.id]|default(null),
                    answer_url: answer_urls[question.id]|default(null),
                    request_token: request_token
                } only %}
            {% endfor %}
        </ol>
    {% endif %}
</div>
