{% set item_attributes = attrs()
    .set('id', "qna-question-#{question.id}")
    .addClass('qna-question-list__item')
    .mergeWith(item_attributes|default)
%}
{% set question_attributes = attrs()
    .addClass('qna-question')
    .addClass('qna-question--answered', question.answered)
    .addClass('qna-question--own', question.isOwn)
    .set('aria-labelledby', "qna-question-#{question.id}-text")
    .mergeWith(question_attributes|default)
%}

<li{{ item_attributes }}>
    <article{{ question_attributes }}>
        <p id="qna-question-{{ question.id }}-text" class="qna-question__text">{{ question.question }}</p>
        <p class="qna-question__votes">
            {{ 'qna.question.vote_count'|trans([question.voteCount], 'contao_default') }}
        </p>

        {% if question.answered %}
            <p class="qna-question__answered">{{ 'qna.question.answered'|trans({}, 'contao_default') }}</p>
        {% endif %}

        {% if answer_url|default(null) %}
            <form{{ attrs().addClass('qna-answer-form').set('action', answer_url).set('method', 'post') }}>
                <input type="hidden" name="REQUEST_TOKEN" value="{{ request_token }}">
                <button{{ attrs()
                    .set('id', "qna-question-#{question.id}-answer")
                    .addClass('qna-button')
                    .set('type', 'submit')
                    .set('aria-describedby', "qna-question-#{question.id}-text")
                }}>
                    {{ (question.answered ? 'qna.question.mark_unanswered' : 'qna.question.mark_answered')|trans({}, 'contao_default') }}
                </button>
            </form>
        {% endif %}

        {% if show_vote_button and not question.answered %}
            <form{{ attrs().addClass('qna-vote-form').set('action', vote_url).set('method', 'post') }}>
                <input type="hidden" name="REQUEST_TOKEN" value="{{ request_token }}">
                <button{{ attrs()
                    .set('id', "qna-question-#{question.id}-vote")
                    .addClass(['qna-button', 'qna-vote-button'])
                    .addClass('qna-vote-button--selected', question.hasVoted)
                    .set('type', 'submit')
                    .set('aria-label', (question.hasVoted ? 'qna.vote.selected_label' : 'qna.vote.label')|trans([question.question], 'contao_default'))
                    .set('aria-pressed', question.hasVoted ? 'true' : 'false')
                }}>
                    {{ (question.hasVoted ? 'qna.vote.selected' : 'qna.vote.submit')|trans({}, 'contao_default') }}
                </button>
            </form>
        {% endif %}
    </article>
</li>
